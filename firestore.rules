rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------
    // FONCTIONS D'AIDE (Helper functions)
    // ---------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/\/documents/users/\).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isProf() {
      return isAuthenticated() && getUserData().role == 'prof';
    }

    function isParent() {
      return isAuthenticated() && getUserData().role == 'parent';
    }

    // ---------------------------------------------------------
    // RÈGLES PAR COLLECTION
    // ---------------------------------------------------------

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.token.email == userId || isAdmin());
      allow create, delete: if isAdmin() || (isAuthenticated() && request.auth.token.email == 'lionel.henrion@gmail.com');
    }

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isProf();
    }
    
    match /prof_hours/{docId} {
      allow read: if isAdmin() || isProf();
      allow write: if isAdmin() || isProf();
    }

    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isProf() || isParent();
    }

        match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'prof');
    }
    match /event_rehearsals/{repId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'prof');
    }

    // Collection ANNOUNCEMENTS (Les notifications internes et push)
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isProf() || isParent();
      allow update, delete: if isAdmin() || (isProf() && resource.data.authorId == request.auth.token.email);
    }

        match /events/{eventId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'prof');
    }
    match /event_rehearsals/{repId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'prof');
    }

    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isProf();
    }
    
    match /history/{historyId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || isProf(); 
    }

    match /inscriptions/{inscId} {
      allow create: if true; 
      allow read, update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      function isConvParticipant() {
        return isAuthenticated() && (request.auth.token.email in resource.data.participants);
      }
      
      allow read: if isAuthenticated();
      allow create: if isAuthenticated(); 
      allow update: if isConvParticipant() || isAdmin() || (isAuthenticated() && resource.data.isGroup == true);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function getParentConv() {
          return get(/databases/\/documents/conversations/\).data;
        }
        function isParentConvParticipant() {
          return isAuthenticated() && (request.auth.token.email in getParentConv().participants);
        }
        
        allow read: if isAuthenticated();
        allow create: if (isParentConvParticipant() || isAdmin() || (isAuthenticated() && getParentConv().isGroup == true)) && request.resource.data.senderId == request.auth.token.email;
        allow delete: if isAdmin() || resource.data.senderId == request.auth.token.email;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

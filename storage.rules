rules_version = '2';

// Craft rules based on standard Firebase Storage rules
service firebase.storage {
  match /b/{bucket}/o {
    // Allows any user authenticated in the app to upload/read chat files
    match /chat/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    
    // Explicit deny for anything else to be safe, or just let it fall through
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Since we might need it for avatars etc
    }
  }
}
